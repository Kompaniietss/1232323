{
  "controller": {"model": "Arduino Mega 2560", "family": "atmelavr"},
  "processor": {"flash": "256KB", "sram": "8KB"},
  "sensors": [
    {"id": "button", "kind": "push_button", "pin": 2, "pull": "GND", "debounceMs": 20}
  ],
  "actuators": [
    {"id": "greenLed", "kind": "led", "pin": 5, "color": "green"},
    {"id": "yellowLed", "kind": "led", "pin": 6, "color": "yellow"},
    {"id": "redLed", "kind": "led", "pin": 7, "color": "red"}
  ],
  "links": [
    {"id": "uart1", "role": "sensor->actuator", "tx": "Serial1", "rx": "Serial2"},
    {"id": "uart2", "role": "actuator->sensor", "tx": "Serial2", "rx": "Serial1"}
  ],
  "wokwi": {
    "version": 1,
    "author": "iot",
    "editor": "wokwi",
    "parts": [
      {"type": "wokwi-arduino-mega", "id": "mega", "top": 0, "left": 0, "attrs": {}},
      {"type": "wokwi-pushbutton", "id": "btn1", "top": -130, "left": 20, "attrs": {"color": "blue"}},
      {"type": "wokwi-led", "id": "ledG", "top": -140, "left": 150, "attrs": {"color": "green"}},
      {"type": "wokwi-led", "id": "ledY", "top": -140, "left": 220, "attrs": {"color": "yellow"}},
      {"type": "wokwi-led", "id": "ledR", "top": -140, "left": 290, "attrs": {"color": "red"}},
      {"type": "wokwi-resistor", "id": "rG", "top": -75, "left": 120, "rotate": 90, "attrs": {"value": "220"}},
      {"type": "wokwi-resistor", "id": "rY", "top": -75, "left": 190, "rotate": 90, "attrs": {"value": "220"}},
      {"type": "wokwi-resistor", "id": "rR", "top": -75, "left": 260, "rotate": 90, "attrs": {"value": "220"}}
    ],
    "connections": [
      ["mega:2", "btn1:1.l", "blue", []],
      ["btn1:2.l", "mega:GND.1", "black", []],
      ["mega:5", "rG:1", "green", []],
      ["rG:2", "ledG:A", "green", []],
      ["ledG:C", "mega:GND.1", "black", []],
      ["mega:6", "rY:1", "yellow", []],
      ["rY:2", "ledY:A", "yellow", []],
      ["ledY:C", "mega:GND.1", "black", []],
      ["mega:7", "rR:1", "red", []],
      ["rR:2", "ledR:A", "red", []],
      ["ledR:C", "mega:GND.1", "black", []],
      ["mega:18", "mega:17", "orange", []],
      ["mega:16", "mega:19", "purple", []]
    ],
    "dependencies": {}
  },
  "notes": [
    "The sensor and actuator share one firmware image but behave as two logical nodes separated by a real UART link.",
    "The generated Wokwi diagram wires the button to GND and the LEDs with 220 ohm resistors."
  ]
}
